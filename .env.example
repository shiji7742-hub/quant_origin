FLASK_SECRET_KEY=replace-with-a-long-random-secret
QUANT_APP_USERNAME=admin
QUANT_APP_PASSWORD=ChangeMe123!
# 或者改用密码哈希（二选一）
# QUANT_APP_PASSWORD_HASH=replace-with-werkzeug-password-hash
LOGIN_SESSION_HOURS=12
# 只有在 HTTPS 反向代理后才改成 true
SESSION_COOKIE_SECURE=false
# 全市场扫描时最多处理多少只候选股票
MARKET_SCAN_MAX_CANDIDATES=20
# 全市场扫描并发线程数
MARKET_SCAN_MAX_WORKERS=6
# 单股历史K线数据源: tx 或 em
STOCK_HISTORY_PROVIDER=tx

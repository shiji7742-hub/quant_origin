FLASK_SECRET_KEY=replace-with-a-long-random-secret
QUANT_APP_USERNAME=admin
QUANT_APP_PASSWORD=replace-with-your-local-password
# 或者改用密码哈希（二选一）
# QUANT_APP_PASSWORD_HASH=replace-with-werkzeug-password-hash
LOGIN_SESSION_HOURS=12
# 只有在 HTTPS 反向代理后才改成 true
SESSION_COOKIE_SECURE=false
# 全市场扫描时最多处理多少只候选股票
MARKET_SCAN_MAX_CANDIDATES=20
# 全市场扫描并发线程数
MARKET_SCAN_MAX_WORKERS=6
# 全市场扫描缓存最长保留秒数
MARKET_SCAN_CACHE_MAX_AGE_SECONDS=45
# 后台扫描失败后的最短重试间隔
MARKET_SCAN_RETRY_DELAY_SECONDS=15
# 后台扫描超过该秒数仍未结束时，视为僵死任务
MARKET_SCAN_REFRESH_STALE_SECONDS=1800
# 收盘后自动刷新的触发时间（默认 15:05）
MARKET_SCAN_AUTO_REFRESH_HOUR=15
MARKET_SCAN_AUTO_REFRESH_MINUTE=5
# 后台调度器轮询周期
MARKET_SCAN_AUTO_REFRESH_POLL_SECONDS=30
# 单股历史K线数据源: tx 或 em
STOCK_HISTORY_PROVIDER=tx
# 可选: Tushare 相关脚本读取此环境变量
# TUSHARE_TOKEN=replace-with-your-local-tushare-token
